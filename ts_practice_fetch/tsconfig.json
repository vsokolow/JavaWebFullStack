{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Строгий режим — главное, ради чего мы здесь.
       Без него TS не поймает ни null, ни неявный any. */
    "strict": true,

    /* Намеренно выключено: в заготовке много ещё не использованных
       заглушек, и мы не хотим, чтобы студенты тонули в красных
       подчёркиваниях до того, как напишут первую строчку. */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
